# Copy to .env.local for local development. .env.local is gitignored.

# Port for the custom Express + Next server (server.js)
PORT=3000

# Stripe secret key. Use a sandbox key (sk_test_...) locally; the VM's
# .env.local holds the live key. Without it, product pages still work and
# the pay-what-you-want button shows as unavailable.
STRIPE_SECRET_KEY=

# Optional. Public origin for Stripe return URLs. Defaults to the request's
# Host / X-Forwarded-* headers, which is right behind the VM's nginx.
# SITE_URL=https://thecollabagepatch.com

# Optional. Raises GitHub's API limit for release lookups (60/hour unauthenticated).
# GITHUB_TOKEN=
