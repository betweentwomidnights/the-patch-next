// Tailnet policy for the Collabage Patch tailnet.
// Kept here for reference; the live copy is in the Tailscale admin console → Access controls.
// Paste this whole file over the existing policy. Tailscale runs "tests" and "sshTests"
// on save and refuses the change if any of them fail.
//
// Who's who:
//   betweentwomidnights@github  Kevin (admin)
//   heymanhew@github            Matt; SSHes to the spark as "dad"
//   mhendricks1290@gmail.com    the other Matt; SSHes to the spark as "ath"
{
	"tagOwners": {
		"tag:spark":  ["betweentwomidnights@github"],
		"tag:laptop": ["betweentwomidnights@github"],
		// Website VM (public-facing). Can be reached, can't reach anything.
		"tag:web":    ["betweentwomidnights@github"],
		// Ephemeral GitHub Actions deploy runners.
		"tag:ci":     ["betweentwomidnights@github"],
	},

	"grants": [
		// Kevin's devices, the spark and Kevin's tagged laptop reach each other on all ports.
		{
			"src": ["betweentwomidnights@github", "tag:spark", "tag:laptop"],
			"dst": ["betweentwomidnights@github", "tag:spark", "tag:laptop"],
			"ip":  ["*"],
		},
		// Everyone reaches their own devices.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		// Both Matts reach the spark (all ports, e.g. web UIs). Which login they get
		// over SSH is limited in the "ssh" section below.
		{
			"src": ["heymanhew@github", "mhendricks1290@gmail.com"],
			"dst": ["tag:spark"],
			"ip":  ["*"],
		},
		// Deploys: CI runners may reach only the website VM's SSH.
		// This is plain OpenSSH on the VM (NOT Tailscale SSH), so the forced-command
		// deploy key in ~/.ssh/authorized_keys still decides what CI can do.
		{
			"src": ["tag:ci"],
			"dst": ["tag:web"],
			"ip":  ["tcp:22"],
		},
		// Kevin can SSH to the website VM over the tailnet (admin, media sync).
		{
			"src": ["betweentwomidnights@github"],
			"dst": ["tag:web"],
			"ip":  ["tcp:22"],
		},
	],

	"ssh": [
		// Kevin: any non-root user on the spark and his tagged laptop.
		{
			"action": "accept",
			"src":    ["betweentwomidnights@github"],
			"dst":    ["tag:spark", "tag:laptop"],
			"users":  ["autogroup:nonroot"],
		},
		// Kevin: his own devices, as kev or dad.
		{
			"action": "accept",
			"src":    ["betweentwomidnights@github"],
			"dst":    ["autogroup:self"],
			"users":  ["kev", "dad"],
		},
		// Matt: the spark, as dad only.
		{
			"action": "accept",
			"src":    ["heymanhew@github"],
			"dst":    ["tag:spark"],
			"users":  ["dad"],
		},
		// mhendricks: the spark, as ath only.
		{
			"action": "accept",
			"src":    ["mhendricks1290@gmail.com"],
			"dst":    ["tag:spark"],
			"users":  ["ath"],
		},
	],

	"tests": [
		// Kevin keeps full access. (100.119.14.55 = kevins-macbook-pro)
		{"src": "betweentwomidnights@github", "accept": ["tag:spark:22", "tag:spark:443", "tag:laptop:22", "tag:web:22", "100.119.14.55:22"]},
		// Matt: the spark and his own machine (100.77.171.84 = msi-3), nothing else.
		{"src": "heymanhew@github", "accept": ["tag:spark:22", "tag:spark:443", "100.77.171.84:22"], "deny": ["tag:web:22", "tag:laptop:22", "100.119.14.55:22"]},
		// mhendricks: the spark only. Never the website VM.
		{"src": "mhendricks1290@gmail.com", "accept": ["tag:spark:22", "tag:spark:443"], "deny": ["tag:web:22", "tag:web:443", "tag:laptop:22", "100.119.14.55:22", "100.77.171.84:22"]},
		// CI can only reach the website VM's SSH port.
		{"src": "tag:ci", "accept": ["tag:web:22"], "deny": ["tag:web:80", "tag:spark:22", "tag:spark:443", "tag:laptop:22", "100.119.14.55:22"]},
		// The website VM can't reach anything on the tailnet.
		{"src": "tag:web", "deny": ["tag:spark:22", "tag:spark:443", "tag:laptop:22", "100.119.14.55:22"]},
	],

	"sshTests": [
		{"src": "heymanhew@github", "dst": ["tag:spark"], "accept": ["dad"], "deny": ["kev", "ath", "root"]},
		{"src": "mhendricks1290@gmail.com", "dst": ["tag:spark"], "accept": ["ath"], "deny": ["kev", "dad", "root"]},
		{"src": "betweentwomidnights@github", "dst": ["tag:spark"], "accept": ["kev"], "deny": ["root"]},
	],
}
